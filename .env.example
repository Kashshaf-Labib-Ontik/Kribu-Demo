# PostgreSQL development credentials. Replace these outside local development.
POSTGRES_DB=kribu
POSTGRES_USER=kribu
POSTGRES_PASSWORD=kribu_dev_only
POSTGRES_PORT=5432

# API
KRIBU_ENVIRONMENT=development
KRIBU_LOG_LEVEL=INFO
KRIBU_DATABASE_URL=postgresql+asyncpg://kribu:kribu_dev_only@localhost:5432/kribu
KRIBU_CORS_ORIGINS=["http://localhost:3000"]
API_PORT=8000

# Web
INTERNAL_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
WEB_PORT=3000

# Gemini free-tier inference for synthetic demo data only.
# Never commit this key or send real client/confidential data to the free tier.
KRIBU_MODEL_PROVIDER=gemini
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.1

