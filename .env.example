# PostgreSQL development credentials. Replace these outside local development.
POSTGRES_DB=kribu
POSTGRES_USER=kribu
POSTGRES_PASSWORD=kribu_dev_only
POSTGRES_PORT=5432
KRIBU_APP_DB_PASSWORD=kribu_app_dev_only

# Keycloak development database and bootstrap account. These are local-demo defaults only.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=kribu_admin_dev_only
KEYCLOAK_PORT=8180

# Synthetic demo-user passwords used only by the imported local Keycloak realm.
KRIBU_DEMO_MIKE_PASSWORD=mike_demo_only
KRIBU_DEMO_HR_PASSWORD=hr_demo_only
KRIBU_DEMO_MANAGER_PASSWORD=manager_demo_only
KRIBU_DEMO_EXTERNAL_PASSWORD=external_demo_only

# API
KRIBU_ENVIRONMENT=development
KRIBU_LOG_LEVEL=INFO
KRIBU_DATABASE_URL=postgresql+asyncpg://kribu_app:kribu_app_dev_only@localhost:5432/kribu
KRIBU_MIGRATION_DATABASE_URL=postgresql+asyncpg://kribu:kribu_dev_only@localhost:5432/kribu
KRIBU_CORS_ORIGINS=["http://localhost:3000"]
KRIBU_OIDC_ISSUER_URL=http://localhost:8180/realms/kribu-demo
KRIBU_OIDC_JWKS_URL=http://localhost:8180/realms/kribu-demo/protocol/openid-connect/certs
KRIBU_OIDC_AUDIENCE=kribu-api
KRIBU_OIDC_CLOCK_SKEW_SECONDS=30
KRIBU_OPA_URL=http://localhost:8181
KRIBU_OPA_TIMEOUT_SECONDS=2
KRIBU_OPA_POLICY_VERSION=guard-v2
# Original uploaded files (host runs; Compose mounts a named volume instead). Gitignored.
KRIBU_DOCUMENT_STORE_PATH=storage/documents
KRIBU_UPLOAD_MAX_BYTES=26214400
# Redis is the Celery broker only; PostgreSQL ingestion jobs/outbox remain authoritative.
KRIBU_CELERY_BROKER_URL=redis://localhost:6379/0
KRIBU_INGESTION_OWNER_DATABASE_URL=postgresql+asyncpg://kribu:kribu_dev_only@localhost:5432/kribu
KRIBU_INGESTION_POLL_SECONDS=15
KRIBU_INGESTION_TASK_TIMEOUT_SECONDS=120
KRIBU_INGESTION_MAX_PDF_PAGES=250
KRIBU_INGESTION_MAX_CONTENT_UNITS=100000
API_PORT=8000

# Web
INTERNAL_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
WEB_PORT=3000

# Gemini free-tier inference for synthetic demo data only.
# Never commit this key or send real client/confidential data to the free tier.
KRIBU_MODEL_PROVIDER=gemini
KRIBU_MODEL_DATA_POLICY=synthetic_only
KRIBU_GEMINI_API_KEY=replace_with_google_ai_studio_key
KRIBU_GEMINI_MODEL=gemini-3.8-flash
KRIBU_GEMINI_MAX_OUTPUT_TOKENS=4096
KRIBU_GEMINI_TEMPERATURE=0.1
KRIBU_GEMINI_TIMEOUT_SECONDS=30
KRIBU_GEMINI_RETRY_ATTEMPTS=3

