        "department": ["human-resources"]
      },
      "credentials": [
        { "type": "password", "value": "${KRIBU_DEMO_HR_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["hr_manager"]
    },
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3",
      "username": "priya.manager",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Priya",
      "lastName": "Sen",
      "email": "priya.manager@kribu.demo",
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"],
        "department": ["programs"]
      },
      "credentials": [
        { "type": "password", "value": "${KRIBU_DEMO_MANAGER_PASSWORD}", "temporary": false }
      ],
